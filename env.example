# Environment Configuration for Influencer Flow
# Copy this file to .env and fill in your actual values

# ================================
# VAPI Configuration (Voice AI)
# ================================
# Required for voice communication features
VAPI_ORG_ID=your_vapi_org_id_here
VAPI_PRIVATE_KEY=your_vapi_private_key_here
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here

# ================================
# OpenAI Configuration
# ================================
# Required for AI chat and conversation features
OPENAI_API_KEY=your_openai_api_key_here

# ================================
# ElevenLabs Configuration
# ================================
# Required for high-quality AI voice synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice Configuration
# Default voice IDs for different AI personalities
ELEVENLABS_VOICE_ID_BRAND_REP=21m00Tcm4TlvDq8ikWAM     # Rachel - Professional female voice
ELEVENLABS_VOICE_ID_SALES=N2lVS1w4EtoT3dr4eOWO          # Callum - Confident male voice  
ELEVENLABS_VOICE_ID_SUPPORT=EXAVITQu4vr4xnSDxMaL        # Bella - Friendly female voice

# ================================
# Supabase Configuration
# ================================
# For data storage and user management
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ================================
# Stream Configuration
# ================================
# For video and chat features
STREAM_API_KEY=your_stream_api_key_here
STREAM_SECRET_KEY=your_stream_secret_key_here

# ================================
# Other API Keys
# ================================
# Add other service API keys as needed
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ================================
# Development Configuration
# ================================
# Application will run in demo mode if VAPI credentials are missing
# This is perfect for development and testing
NODE_ENV=development

# ================================
# Production Configuration
# ================================
# For production deployment, ensure all required keys are set:
# - VAPI_ORG_ID
# - VAPI_PRIVATE_KEY  
# - NEXT_PUBLIC_VAPI_PUBLIC_KEY
# - OPENAI_API_KEY
# 
# The application will automatically detect the configuration
# and switch between demo and production modes accordingly.

# LangGraph API Configuration
LANGGRAPH_API_URL=http://localhost:8000
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Copilot Configuration
# Note: The COPILOTKIT_API_KEY is used in production environments
# For local development, you typically don't need to set this
COPILOTKIT_API_KEY=your_copilotkit_api_key_here

# If you're running the LangGraph agent locally, use http://localhost:8000
# If you're using LangGraph Platform, use the URL provided by LangGraph

# Optional: Uncomment and set these if needed
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For Vite (Vite style) - Use this if the above doesn't work
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here 